{
	"name": "houseofbugs/phpservermon",
	"description": "PHP Server Monitor (2026 Fork)",
	"license": "GPL-3.0-or-later",
	"homepage": "https://github.com/houseofbugs/phpservermon",
	"require": {
		"php": ">=8.2",
		"ext-curl": "*",
		"ext-json": "*",
		"ext-pdo": "*",
		"ext-xml": "*",
		"phpmailer/phpmailer": "^6.9",
		"symfony/config": "^6.4",
		"symfony/dependency-injection": "^6.4",
		"symfony/event-dispatcher": "^6.4",
		"symfony/http-foundation": "^6.4",
		"symfony/filesystem": "^6.4",
		"symfony/deprecation-contracts": "^2.5|^3.5",
		"symfony/event-dispatcher-contracts": "^2.5|^3.5",
		"php-pushover/php-pushover": "^1.0",
		"paragonie/random_compat": "^9.99",
		"twig/twig": "^3.14",
		"jaxl/jaxl": "^3.1"
	},
	"autoload": {
		"files": [
			"./src/includes/psmconfig.inc.php",
			"./src/includes/functions.inc.php"
		],
		"psr-4": {
			"psm\\": "src/psm/"
		}
	}
}
